# ─────────────────────────────────────────────────────────────────────────────
#  DLMP automated deployment — one-time setup
#
#  cp .deploy-secrets.example .deploy-secrets     (gitignored — never commit)
#  Fill in the three tokens below, then run:  make deploy
#
#  All three consoles log in with tangellamanoj9@gmail.com (Google login):
# ─────────────────────────────────────────────────────────────────────────────

# 1) https://console.aiven.io/profile/tokens  →  "Generate token"
AIVEN_TOKEN=

# 2) https://console.upstash.com/account/api  →  "Create API key"
UPSTASH_EMAIL=tangellamanoj9@gmail.com
UPSTASH_API_KEY=

# 3) https://dashboard.render.com/settings#api-keys  →  "Create API Key"
RENDER_API_KEY=

# 4) (only if deploying the frontend) https://vercel.com/account/tokens  →  "Create Token"
VERCEL_TOKEN=

# ── Everything below is OPTIONAL — auto-generated / auto-detected ────────────
# AIVEN_PROJECT=            # auto-detected if you have one project
# GITHUB_REPO=https://github.com/Tangella-Manoj/dlmp
# JWT_SECRET=               # auto-generated on first run, then reused
# INTERNAL_API_KEY=         # auto-generated on first run, then reused
# ADMIN_EMAIL=tangellamanoj9@gmail.com
# ADMIN_PASSWORD=           # auto-generated on first run — your admin login
# MAIL_ENABLED=false        # set true + fill MAIL_PASSWORD/MAIL_FROM for real emails
# MAIL_PASSWORD=
# MAIL_FROM=

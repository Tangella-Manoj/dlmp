# ─────────────────────────────────────────────────────────────────────────────
#  DLMP v2.0 — Render.com Production Environment
#  All free, no credit card. db4free MySQL + Upstash Kafka/Redis
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain (Render gives this automatically) ──────────────────────────────────
DOMAIN=dlmp-gateway.onrender.com
CORS_ALLOWED_ORIGINS=https://dlmp-gateway.onrender.com

# ── Database — db4free.net (free MySQL, no credit card) ───────────────────────
# Sign up at db4free.net — gives 1 free MySQL database
# All 6 services share 1 MySQL instance, different schemas handled by Flyway
MYSQL_HOST=db4free.net
MYSQL_PORT=3306
MYSQL_USER=your_db4free_username
MYSQL_PASSWORD=your_db4free_password
MYSQL_ROOT_PASSWORD=your_db4free_password

# ── Upstash Redis (free, no credit card) ──────────────────────────────────────
# Sign up at upstash.com with GitHub
REDIS_HOST=your-redis.upstash.io
REDIS_PORT=6380
REDIS_PASSWORD=your_upstash_redis_password
REDIS_SSL_ENABLED=true

# ── Upstash Kafka (free, no credit card) ──────────────────────────────────────
KAFKA_SERVERS=your-cluster.upstash.io:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_JAAS=org.apache.kafka.common.security.scram.ScramLoginModule required username="your-upstash-user" password="your-upstash-pass";

# ── JWT (generate with: openssl rand -base64 64) ─────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_SECRET_openssl_rand_base64_64

# ── Email — SendGrid single sender (your Gmail, already verified) ─────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
MAIL_FROM=your.gmail@gmail.com
MAIL_FROM_NAME=DLMP Platform

# ── Grafana (monitoring) ──────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# ── OTLP Tracing (optional — leave as-is for now) ─────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

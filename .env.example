# ─────────────────────────────────────────────────────────────────────────────
#  DLMP v2.0 — Environment template
#
#  • Local dev needs NO .env — application.yml defaults + docker-compose /
#    scripts/start-services.sh cover everything.
#  • For Render, set these in the dashboard (see docs/RENDER_DEPLOYMENT.md).
#  • For VPS deploys (docker-compose.prod.yml), copy this to .env and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain / CORS ─────────────────────────────────────────────────────────────
DOMAIN=dlmp-gateway.onrender.com
CORS_ALLOWED_ORIGINS=https://dlmp-gateway.onrender.com

# ── MySQL — Aiven (free tier) ─────────────────────────────────────────────────
# One database (defaultdb); all services share it with per-service Flyway
# history tables. Values come from the Aiven console → Service Overview.
MYSQL_HOST=your-project.aivencloud.com
MYSQL_PORT=24351
MYSQL_DB=defaultdb
MYSQL_SSL=true
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_aiven_mysql_password
# Only used by docker-compose.prod.yml (self-hosted MySQL):
MYSQL_ROOT_PASSWORD=change_me_root_password

# ── Redis — Upstash (free tier) ───────────────────────────────────────────────
REDIS_HOST=your-redis.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password
REDIS_SSL_ENABLED=true

# ── Kafka — Aiven (free tier) ─────────────────────────────────────────────────
# Create topics first: dlmp.loan.events, dlmp.payment.events, dlmp.user.events
KAFKA_SERVERS=your-kafka.aivencloud.com:24364
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_JAAS=org.apache.kafka.common.security.scram.ScramLoginModule required username="avnadmin" password="your-kafka-password";
# Full PEM contents of the Aiven CA certificate (multi-line values are fine)
AIVEN_CA_CERT=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64 | tr -d '\n'
# MUST be identical across ALL services (gateway validates, services re-validate)
JWT_SECRET=REPLACE_WITH_64_CHAR_SECRET_openssl_rand_base64_64
# Shared secret for loan-service → user-service internal calls.
# Generate: openssl rand -hex 32   (same value on user-service AND loan-service)
INTERNAL_API_KEY=REPLACE_WITH_openssl_rand_hex_32

# ── Initial admin account (optional — user-service creates it on startup) ─────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChooseAStrongPassword!

# ── Email — SendGrid/Brevo SMTP (optional; MAIL_ENABLED=false disables sends) ─
MAIL_ENABLED=false
SENDGRID_API_KEY=SG.your_sendgrid_api_key
MAIL_FROM=your.verified.sender@example.com
MAIL_FROM_NAME=DLMP Platform

# ── Grafana (docker-compose.prod.yml only) ────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# ── OTLP Tracing (optional) ───────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
